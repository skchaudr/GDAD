{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdad:stage1:journal-event",
  "title": "GDAD Stage 1 progress journal event",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "node_id", "status", "at", "actor"],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "const": "dispatched"
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["human", "system"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
