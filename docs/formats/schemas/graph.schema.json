{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdad:stage1:graph",
  "title": "GDAD Stage 1 graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id"],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    }
  }
}
