{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdad:stage1:verdict",
  "title": "GDAD Stage 1 verdict",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "pass"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "findings"],
      "properties": {
        "kind": {
          "const": "fail"
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "affected_node_ids", "rationale", "evidence"],
      "properties": {
        "kind": {
          "enum": [
            "split",
            "supersede",
            "insert_prerequisite",
            "revise_criteria",
            "rewire",
            "reorder",
            "create_node",
            "retire_node"
          ]
        },
        "affected_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
