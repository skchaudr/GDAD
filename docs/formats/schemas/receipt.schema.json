{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gdad:stage1:receipt",
  "title": "GDAD Stage 1 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "node_id",
    "attempt_id",
    "generated_at",
    "actor",
    "evidence",
    "verdict"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "const": "evaluator"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "$ref": "urn:gdad:stage1:verdict"
    }
  }
}
